# vLLM Configuration
# ==================

# Which LLM provider to use: 'claude' or 'vllm'
ANTHROPIC_PROVIDER=vllm

# vLLM API Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=sk-local-key

# vLLM Model Selection
# Options: meta-llama/Llama-2-7b-chat-hf, meta-llama/Llama-2-13b-chat-hf, 
#          meta-llama/Llama-2-70b-chat-hf, mistralai/Mistral-7B-Instruct-v0.1, etc.
ANTHROPIC_MODEL=meta-llama/Llama-2-7b-chat-hf

# vLLM Server Configuration
VLLM_TAG=latest
TENSOR_PARALLEL_SIZE=1
QUANTIZATION=

# HuggingFace Token (for private models)
HUGGINGFACE_TOKEN=

# Resource Limits
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=4096

# Claude Fallback (optional - for redundancy)
ANTHROPIC_API_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration (for pgvector)
POSTGRES_DB=basma
POSTGRES_USER=basma
POSTGRES_PASSWORD=basma123

# Voice Settings
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Security
JWT_SECRET=
ENCRYPTION_KEY=

# Environment
ENVIRONMENT=development
